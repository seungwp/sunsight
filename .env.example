# KEPCO API — Python 스크립트 전용, VITE_ 접두사 사용 금지
KEPCO_API_KEY=your_kepco_api_key
KEPCO_API_URL=https://bigdata.kepco.co.kr/openapi/v1/dispersedGeneration.do

VITE_NAVER_CLIENT_ID=your_naver_client_id
# NAVER_CLIENT_SECRET은 서버사이드 전용 — VITE_ 접두사 사용 금지 (브라우저 번들에 노출됨)
# NAVER_CLIENT_SECRET=your_naver_client_secret

# data.go.kr 공공데이터포털 서비스 키 (Decoding 일반 인증키)
# 한국에너지기술연구원 태양에너지 시공간 자원정보 서비스 + 태양광 발전량 예측정보 서비스
KIER_SERVICE_KEY=your_kier_service_key

# 기상청_지상(종관, ASOS) 시간자료 조회서비스
KMA_SERVICE_KEY=your_kma_service_key
